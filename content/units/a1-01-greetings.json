      ]
    },
    {
      "id": "a1-01-prac-6",
      "kind": "translate",
      "instruction_pt": "Diga em inglês: \"Prazer em te conhecer também.\"",
      "accepted": [
        "Nice to meet you too",
        "Nice meeting you too",
        "Pleased to meet you too",
