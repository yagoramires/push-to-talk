            {
              "en": "spring",
              "pt": "primavera"
            },
            {
              "en": "fall",
              "pt": "outono"
            }
          ]
        },
        {
          "id": "a1-11-vocab-5",
          "kind": "translate",
          "instruction_pt": "Diga em inglês: \"Está chovendo.\"",
          "accepted": [
            "It's raining",
            "It is raining",
            "It's rainy",
            "It's raining a lot",
            "It's raining now",
            "It's pouring"
