              { "en": "sister", "pt": "irmã" },
              { "en": "son", "pt": "filho" },
              { "en": "grandmother", "pt": "avó" },
              { "en": "wife", "pt": "esposa" }
            ]
          }
        },
        {
          "skill": "vocabulary",
          "unitId": "a1-02-numbers-age",
          "exercise": {
            "id": "ex-a1-vocab-2",
            "kind": "choice",
            "instruction_pt": "Como se escreve \"quarenta\" em inglês?",
            "options": ["fourteen", "forty", "fourty"],
            "answer": 1,
            "explanation_pt": "Quarenta é \"forty\", sem o \"u\" de \"four\". \"Fourteen\" é 14."
          }
        },
        {
          "skill": "vocabulary",
          "exercise": {
            "id": "ex-a1-vocab-3",
            "kind": "match",
            "instruction_pt": "Ligue cada comida ao significado.",
            "pairs": [
              { "en": "bread", "pt": "pão" },
              { "en": "cheese", "pt": "queijo" },
              { "en": "chicken", "pt": "frango" },
              { "en": "rice", "pt": "arroz" },
              { "en": "beans", "pt": "feijão" }
            ]
          }
        },
        {
          "skill": "vocabulary",
          "unitId": "a1-01-greetings",
          "exercise": {
            "id": "ex-a1-vocab-4",
            "kind": "choice",
            "instruction_pt": "Você está indo embora de uma festa às 23h. O que você diz?",
            "options": ["Good night!", "Good evening!", "Good afternoon!"],
            "answer": 0,
            "explanation_pt": "\"Good night\" é para se despedir à noite ou antes de dormir. \"Good evening\" é para cumprimentar quando você chega."
          }
        },
        {
          "skill": "vocabulary",
          "exercise": {
            "id": "ex-a1-vocab-5",
            "kind": "match",
            "instruction_pt": "Ligue cada lugar ao significado.",
            "pairs": [
              { "en": "library", "pt": "biblioteca" },
              { "en": "bakery", "pt": "padaria" },
              { "en": "drugstore", "pt": "farmácia" },
              { "en": "school", "pt": "escola" },
              { "en": "bookstore", "pt": "livraria" }
            ]
          }
        }
      ]
    },
    {
      "skill": "structure",
      "items": [
        {
          "skill": "structure",
          "unitId": "a1-01-greetings",
          "exercise": {
            "id": "ex-a1-struct-1",
            "kind": "fill",
            "instruction_pt": "Complete a frase.",
            "sentence": "They ___ from Argentina.",
            "accepted": ["are"],
            "commonErrors": [
              {
                "id": "they-is",
                "match": "^(is|am|be)$",
                "explanation_pt": "Com \"they\" (e também we e you) o verbo \"to be\" é \"are\": \"They are from Argentina\".",
                "correction_en": "They are from Argentina."
              }
            ]
          }
        },
        {
          "skill": "structure",
          "exercise": {
            "id": "ex-a1-struct-2",
            "kind": "fill",
            "instruction_pt": "Complete com o verbo \"drink\" no presente.",
            "sentence": "He ___ coffee every morning.",
            "accepted": ["drinks"],
            "commonErrors": [
              {
                "id": "third-person-s",
                "match": "^(drink|is drink|is drinking|drinking)$",
                "explanation_pt": "Para um hábito com he, she ou it, o verbo ganha \"-s\": \"He drinks coffee every morning\".",
                "correction_en": "He drinks coffee every morning."
              }
            ]
          }
        },
        {
          "skill": "structure",
          "exercise": {
            "id": "ex-a1-struct-3",
            "kind": "fill",
            "instruction_pt": "Complete a frase (ela sabe falar três línguas).",
            "sentence": "My sister ___ speak three languages.",
            "accepted": ["can"],
            "commonErrors": [
              {
                "id": "cans-know",
                "match": "^(cans|can to|know|knows|knows how)$",
                "explanation_pt": "Para habilidade usamos \"can\" + verbo, sem \"to\" e sem \"-s\": \"My sister can speak three languages\".",
                "correction_en": "My sister can speak three languages."
              }
            ]
          }
        },
        {
          "skill": "structure",
          "exercise": {
            "id": "ex-a1-struct-4",
            "kind": "order",
            "instruction_pt": "Coloque as palavras na ordem certa.",
            "accepted": ["There are two bedrooms in my house."]
          }
        },
        {
          "skill": "structure",
          "unitId": "a1-02-numbers-age",
          "exercise": {
            "id": "ex-a1-struct-5",
            "kind": "order",
            "instruction_pt": "Coloque as palavras na ordem certa.",
            "accepted": ["How old is your father?"]
          }
        }
      ]
    }
  ]
}
