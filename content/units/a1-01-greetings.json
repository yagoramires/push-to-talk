      "instruction_pt": "Diga em inglês: \"Eu sou de São Paulo.\"",
      "accepted": [
        "I'm from São Paulo",
        "I am from São Paulo",
        "I'm from Sao Paulo",
        "I am from Sao Paulo",
        "I come from São Paulo",
        "I come from Sao Paulo"
      ],
      "commonErrors": [
        {
          "id": "i-from",
          "match": "^i from\\b",
          "explanation_pt": "Falta o verbo: \"I'm from...\", e não \"I from...\".",
          "correction_en": "I'm from São Paulo."
        },
        {
          "id": "is-of",
          "match": "\\b(am|is|are) of\\b",
          "explanation_pt": "\"Ser de\" um lugar é \"to be from\", e não \"of\": \"I'm from Recife\".",
          "correction_en": "I'm from São Paulo."
        }
      ]
    },
    {
      "id": "a1-01-prac-5",
      "kind": "translate",
      "instruction_pt": "Diga em inglês: \"De onde você é?\"",
      "accepted": [
        "Where are you from?",
        "Where do you come from?",
        "Where are you from originally?"
      ],
      "commonErrors": [
        {
          "id": "of-where",
          "match": "^(of|from) where\\b",
          "explanation_pt": "Em inglês a preposição vai no fim: \"Where are you from?\".",
          "correction_en": "Where are you from?"
        },
        {
          "id": "where-you-are",
          "match": "^where you are\\b",
          "explanation_pt": "Na pergunta, o verbo vem antes do sujeito: \"Where are you from?\".",
          "correction_en": "Where are you from?"
