{
  "id": "a1-11-weather",
  "level": "A1",
  "order": 11,
  "title_pt": "O tempo",
  "title_en": "Weather",
  "objective_pt": "Perguntar e dizer como está o tempo (\"It's sunny\", \"It's raining\"), falar da temperatura e das estações, e usar o tempo para puxar conversa.",
  "blocks": [
    {
      "id": "a1-11-warmup",
      "kind": "warmup",
      "minutes": 4,
      "teacher": {
        "goal_pt": "Aquecer com o tempo de hoje, o assunto mais comum para puxar conversa.",
        "prompts": ["What's the weather like today?", "Is it hot or cold now?"],
        "watchFor": [
          "Dizer \"Is hot\" sem o \"It\"; em inglês o tempo sempre começa com \"It's\".",
          "Dizer \"It's doing hot\" (do \"está fazendo calor\")."
        ]
      },
      "exercises": [
        {
          "id": "a1-11-warm-1",
          "kind": "repeat",
          "instruction_pt": "Repita em voz alta.",
          "prompt": "It's a beautiful day today!",
          "accepted": ["It's a beautiful day today", "It is a beautiful day today"],
          "commonErrors": []
        },
        {
          "id": "a1-11-warm-2",
          "kind": "choice",
          "instruction_pt": "Como dizemos \"Está calor\"?",
          "options": ["It's hot.", "Is hot.", "It's doing hot."],
          "answer": 0,
          "explanation_pt": "Para falar do tempo usamos \"It's\": \"It's hot\". O \"it\" não pode sumir."
        },
        {
          "id": "a1-11-warm-3",
          "kind": "translate",
          "instruction_pt": "Diga em inglês: \"Está frio hoje.\"",
          "accepted": [
            "It's cold today",
            "It is cold today",
            "Today it's cold",
            "It's very cold today",
            "It's really cold today",
            "It's chilly today",
            "Today is cold",
            "It's a cold day today"
          ],
          "commonErrors": [
            {
              "id": "is-cold-no-it",
              "match": "^is (cold|very cold)\\b",
              "explanation_pt": "Falta o sujeito: em inglês dizemos \"It's cold\".",
              "correction_en": "It's cold today."
            },
            {
              "id": "doing-cold",
              "match": "\\b(doing|making|does|makes) (cold|a cold)\\b",
              "explanation_pt": "\"Fazer frio\" não usa \"do\" nem \"make\": \"It's cold\".",
              "correction_en": "It's cold today."
            }
          ]
        }
      ]
    },
    {
      "id": "a1-11-vocabulary",
      "kind": "vocabulary",
      "minutes": 5,
      "teacher": {
        "goal_pt": "Aprender palavras do tempo e estações: sunny, cloudy, rainy, windy, hot, warm, cold, summer, winter, spring, fall.",
        "prompts": [
          "What's your favorite season?",
          "Is it rainy in your city?",
          "Do you like windy days?"
        ],
        "watchFor": [
          "Dizer \"It's sun\"; o adjetivo é \"sunny\".",
          "Confundir \"warm\" (morno, agradável) e \"worm\" (minhoca) na pronúncia."
        ]
      },
      "exercises": [
        {
          "id": "a1-11-vocab-1",
          "kind": "vocab",
          "word_en": "sunny",
          "meaning_pt": "ensolarado",
          "example_en": "It's sunny and warm today."
        },
        {
          "id": "a1-11-vocab-2",
          "kind": "vocab",
          "word_en": "raining",
          "meaning_pt": "chovendo",
          "example_en": "Take an umbrella. It's raining."
        },
        {
          "id": "a1-11-vocab-3",
          "kind": "vocab",
          "word_en": "summer",
          "meaning_pt": "verão",
